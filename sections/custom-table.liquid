{% # Test if the table has filled lines (& not 'hide_empty_lines' config) %}
{% assign show_table = false %}
{% if section.settings.hide_empty_lines == true %}
    {%- for block in section.blocks -%}
        {% if block.type == 'single_line_text_field' and block.settings.text.size > 0 %}
            {% assign show_table = true %}
        {% endif %}
    {% endfor %}
{% else %}
    {% assign show_table = true %}
{% endif %}

{% if show_table == true %}
{%- style -%}
    .custom-table-section-{{ section.id }} {
        margin-bottom: 30px;
    }
    .custom-table-section-{{ section.id }} table {
    width: 100%;
    }
{%- endstyle -%}

<div class="page-width custom-table-section-{{ section.id }}">
    <table>
        <thead><tr><th colspan="2">{{ section.settings.custom_table_title }}</th></tr></thead>
        <tbody>
        {%- for block in section.blocks -%}
            {% if block.settings.text != '' or section.settings.hide_empty_lines == false %}
            <tr>
                <th>{{ block.settings.title }}</th>
                <td>{{ block.settings.text }}</td>
            </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{% schema %}
{
  "name": "Custom table",
  "settings": [
    {
      "id": "custom_table_title",
      "type": "text",
      "label": "Table box heading",
      "default": "Title"
    },
    {
      "type": "checkbox",
      "id": "hide_empty_lines",
      "default": false,
      "label": "Hide empty lines"
    }
  ],
  "blocks": [
    {
      "type": "single_line_text_field",
      "name": "line_metafield",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title of the line"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text of the line"
        }
      ]
    }
  ]
}
{% endschema %}
